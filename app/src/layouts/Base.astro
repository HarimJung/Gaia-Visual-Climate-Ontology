---
// Shell + footer. The footer shows the as-of date (view build metadata), the
// build commit (injected at build time; env fallback placeholder), the
// standing independence line, and the honest maturity line — on every page
// (R16, AD-11).
import '../styles/site.css';
// The design canon, through the one codegen door it has (docs/DESIGN.md):
// the six generated <pattern> tiles, inlined once per page so every SVG on it
// can fill from url(#t-hatch-45) and friends, and the token file the browser
// bar's colour is read from — never a hex written here.
// engine/gates/r11-front-imports.mjs permits exactly these two generated
// design artefacts and nothing else under engine/.
import textures from '../../../engine/generated/textures.svg?raw';
import designTokens from '../../../engine/generated/design-tokens.json';
import { census, engineViews } from '../lib/data.mjs';

const PRODUCT = 'National Climate Record Runtime';
const paper = designTokens.tokens['colour.paper'].value;
const { title, description } = Astro.props;
// A placeholder is not provenance: the commit row renders only when a build
// actually supplied one, on a product whose whole pitch is provenance.
const commit = (process.env.GITHUB_SHA || process.env.BUILD_COMMIT || '').slice(0, 7);
const desc = description
  || 'A runtime that reads national climate records and refuses to say more than it can prove: every figure links to the receipt it rests on — document, verbatim quote, SHA-256.';
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={paper} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* The canon's three faces (tokens_record.csv: type.display, type.sans,
        type.code), all shipped from this repo under OFL 1.1 with their
        licence texts beside them — nothing is fetched from a font CDN, so a
        blocked third party cannot change what the page is set in. */}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/bricolage-grotesque-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/hanken-grotesk-400.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/ibm-plex-mono-500.woff2" crossorigin />
    <title>{title === PRODUCT ? title : `${title} — ${PRODUCT}`}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={PRODUCT} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical.href} />
  </head>
  <body>
    {/* the generated texture tiles: one <defs> per page, so reason-family
        marks fill from the canon's own patterns and never a local copy */}
    <Fragment set:html={textures.replace('<svg ', '<svg class="vc-textures" ')} />
    <a class="skip" href="#main">Skip to content</a>
    <header class="bar">
      <div class="wrap">
        <a class="mark" href="/">National Climate Record Runtime</a>
        <nav aria-label="Primary">
          <a href="/">Story</a>
          <a href="/ledger/">World ledger</a>
          <a href="/demo/">How it works</a>
          <a href="/author/">Check a draft</a>
        </nav>
      </div>
    </header>
    <main class="wrap" id="main">
      <slot />
    </main>
    <footer>
      <div class="wrap">
        <p>
          <span class="mono" data-meta="as_of">as of {census.as_of}</span>
          <span aria-hidden="true"> · </span>
          <span class="mono" data-meta="build_id">record build {census.build_id.slice(0, 12)}</span>
          {commit && (
            <>
              <span aria-hidden="true"> · </span>
              <span class="mono" data-meta="build_commit">build {commit}</span>
            </>
          )}
        </p>
        <p>Independent runtime; not an official UNFCCC publication. Every figure links to its receipt.</p>
        <p>Built by Visual Climate Inc. · <a href="https://www.visualclimate.org">visualclimate.org</a></p>
      </div>
    </footer>
  </body>
</html>
