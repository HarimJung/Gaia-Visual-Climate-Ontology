---
// Evidence drawer: one unique, stable URL per receipt, namespaced per country
// (AD-10) — /receipt/<iso3>/<doc_id>/ — one static route per ledger row.
// Routes are enumerated from the views (R1: no instance ids in code); the page
// reads only view JSON (R11).
import Base from '../../../layouts/Base.astro';
import { views, census, fmt } from '../../../lib/data.mjs';

export function getStaticPaths() {
  return views.flatMap((view) => {
    const iso3 = view.country.iso3.toLowerCase();
    return view.rows.map((row) => ({
      params: { iso3, id: row.doc_id },
      props: { row, iso3, country: view.country.name_en },
    }));
  });
}

const { row, iso3, country } = Astro.props;
// Receipt-page figures point at the evidence they rest on: the hash when bytes
// are held, otherwise the recorded state and its reason.
const figHref = row.sha256 ? '#sha256' : '#state';
---

<Base title={`${country} — ${row.title}`}>
  <article class="receipt">
    <p class="crumb"><a href={`/country/${iso3}/#row-${row.doc_id}`}>← {country}</a></p>
    {/* the document's own title carries over from whichever list named it.
        A doc_id repeats across countries — the depositary list is one document
        for all of them — so the name is namespaced by record, or the browser
        sees a duplicate and abandons the transition for the whole page. */}
    <h1 style={`view-transition-name:d-${iso3.toLowerCase()}-${row.doc_id.replace(/[^a-z0-9]+/gi, '-')}`}>{row.title}</h1>
    <p class="muted" style="margin:0 0 26px">receipt <span class="mono">{iso3}/{row.doc_id}</span></p>

    <section class="rblock" id="state" aria-labelledby={`state-h-${row.doc_id}`}>
      <h2 id={`state-h-${row.doc_id}`}>State</h2>
      <p style="margin:0">
        <span class={`chip chip-${row.state}`}>{row.state}</span>
        {row.state_reason && <span class="reason"> {row.state_reason}</span>}
      </p>
      {
        row.refusal && (
          <div class="refusal" style="margin-top:12px">
            <span class="tag">REFUSED — figure extraction, verbatim</span>“{row.refusal}”
          </div>
        )
      }
      {row.receipt_scope && <p class="reason" style="margin:12px 0 0">{row.receipt_scope}</p>}
    </section>

    {
      row.quote && (
        <section class="rblock" id="quote" aria-labelledby={`quote-h-${row.doc_id}`}>
          <h2 id={`quote-h-${row.doc_id}`}>
            Quote, page{' '}
            <a class="fig" data-receipt={row.doc_id} href={row.source_url}>
              {row.quote.page}
            </a>
          </h2>
          <p class="quote">
            <span class="qtext">{row.quote.text}</span>
          </p>
          <p class="reason" style="margin:10px 0 0">
            read as: <span class="mono" data-receipt={row.doc_id}>{row.quote.reading}</span>
          </p>
        </section>
      )
    }

    {/* the case-back: the plate turns over to the three things provenance is
        made of — source, run time, checksum (predecessor Motion.dc.html 05).
        Both faces are plain stacked blocks until the script marks the block
        ready, so JavaScript off loses no fact. */}
    <section class="rblock" id="sha256" aria-labelledby={`hash-h-${row.doc_id}`}>
      <h2 id={`hash-h-${row.doc_id}`}>SHA-256 of the file as fetched</h2>
      {
        row.sha256 ? (
          <div class="caseback" data-caseback>
            <div class="cb-plate">
              <div class="cb-face cb-front">
                <p class="hash">
                  <code id="hashval" data-receipt={row.doc_id}>
                    {row.sha256}
                  </code>
                </p>
              </div>
              <div class="cb-face cb-back">
                <dl>
                  <dt>source</dt>
                  <dd>
                    {row.source_url ? <a href={row.source_url}>{row.source_url}</a> : <span class="chip chip-unknown">none recorded</span>}
                  </dd>
                  <dt>run time</dt>
                  <dd><span data-meta="as_of">{census.as_of}</span></dd>
                  <dt>checksum</dt>
                  <dd class="hash" data-receipt={row.doc_id}>{row.sha256}</dd>
                </dl>
              </div>
            </div>
          </div>
        ) : (
          <div class="void">
            <span class="chip chip-unknown">no bytes held</span>
            <span class="reason"> {row.state_reason}</span>
          </div>
        )
      }
    </section>

    <section class="rblock" aria-labelledby={`facts-h-${row.doc_id}`}>
      <h2 id={`facts-h-${row.doc_id}`}>On record</h2>
      <dl class="facts">
        <dt>type</dt>
        <dd class="mono" style="font-size:14px">{row.doc_type}</dd>
        <dt>date</dt>
        <dd>
          {/* a date this runtime does not hold is an explicit void with its
              reason, never an empty link — the same treatment the source URL
              two rows down already gets */}
          {row.date
            ? <a class="fig" data-receipt={row.doc_id} href={figHref}>{row.date}</a>
            : <span class="chip chip-unknown">no date on record</span>}
        </dd>
        {
          row.size_bytes !== null && (
            <>
              <dt>size</dt>
              <dd>
                <a class="fig" data-receipt={row.doc_id} href={figHref}>
                  {fmt(row.size_bytes)}
                </a>{' '}
                bytes
              </dd>
            </>
          )
        }
        {
          row.pages !== null && (
            <>
              <dt>pages</dt>
              <dd>
                <a class="fig" data-receipt={row.doc_id} href={figHref}>
                  {row.pages}
                </a>
              </dd>
            </>
          )
        }
        <dt>official English</dt>
        <dd>{row.official_english}</dd>
        <dt>source URL</dt>
        <dd>
          {row.source_url ? <a href={row.source_url}>{row.source_url}</a> : <span class="chip chip-unknown">none recorded</span>}
        </dd>
      </dl>
    </section>

    {
      row.provenance.length > 0 && (
        <section class="rblock" aria-labelledby={`prov-h-${row.doc_id}`}>
          <h2 id={`prov-h-${row.doc_id}`}>Provenance notes</h2>
          <ul class="prov" data-receipt={row.doc_id}>
            {row.provenance.map((p) => (
              <li>{p}</li>
            ))}
          </ul>
        </section>
      )
    }
  </article>

  <script is:inline>
    // Progressive enhancement only: with JS off the full hash is plain,
    // selectable text and both faces of the case-back are stacked blocks.
    (function () {
      var box = document.querySelector('[data-caseback]');
      var el = document.getElementById('hashval');
      var row = document.createElement('p');
      row.style.margin = '0';
      if (box) {
        box.setAttribute('data-flip-ready', '');
        var flip = document.createElement('button');
        flip.className = 'cb-btn';
        flip.type = 'button';
        flip.setAttribute('aria-expanded', 'false');
        flip.textContent = 'turn it over';
        flip.addEventListener('click', function () {
          var on = box.hasAttribute('data-flipped');
          if (on) box.removeAttribute('data-flipped');
          else box.setAttribute('data-flipped', '');
          flip.setAttribute('aria-expanded', String(!on));
          flip.textContent = on ? 'turn it over' : 'turn it back';
        });
        row.appendChild(flip);
        box.insertAdjacentElement('afterend', row);
      }
      if (!el || !navigator.clipboard) return;
      var btn = document.createElement('button');
      btn.className = 'copy';
      btn.type = 'button';
      btn.textContent = 'copy hash';
      btn.style.marginLeft = '8px';
      btn.addEventListener('click', function () {
        navigator.clipboard.writeText(el.textContent.trim()).then(function () {
          btn.textContent = 'copied';
          setTimeout(function () { btn.textContent = 'copy hash'; }, 1200);
        });
      });
      if (row.parentNode) row.appendChild(btn);
      else el.parentNode.insertAdjacentElement('afterend', btn);
    })();
  </script>
</Base>
