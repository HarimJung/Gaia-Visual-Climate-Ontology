---
// The demo path (AD-10): world ledger → one country → a figure → its receipt →
// the hash → the author check, every step deep-linked and nothing mocked
// (the authoring step links to its honest documentation). The walked country is the richest
// one in the data (most rows with bytes held, among countries whose view
// carries a page quote); the walked figure comes from its view. Neither is
// ever named in code (R1).
import Base from '../layouts/Base.astro';
import { richestView } from '../lib/data.mjs';

// The same derivation the story page uses, so both walk the same country.
const view = richestView();
const iso3 = view.country.iso3.toLowerCase();
const doc = view.rows.find((r) => r.quote && r.sha256);
const treaty = view.treaty_status.find((t) => t.receipt === doc.doc_id);
const ev = treaty.events[0];
---

<Base title="Demo path">
  <section class="head">
    <h1>Demo path</h1>
    <p class="treaty">From the world ledger to the bytes behind one figure. Every step below is a link.</p>
  </section>

  <ol class="steps-list">
    <li>
      <h2><a href="/ledger/">The world ledger</a></h2>
      <p>
        One row per country on record: its counts, and the strip of what this runtime has read so
        far. Every number is a link.
      </p>
    </li>
    <li>
      <h2><a href={`/country/${iso3}/`}>One country: {view.country.name_en}</a></h2>
      <p>
        Zero clicks past the row: country name, treaty status in one line, the next relevant date,
        and the completeness strip.
      </p>
    </li>
    <li>
      <h2><a href={`/country/${iso3}/#treaty`}>One figure</a></h2>
      <p>
        The {treaty.treaty_label} {ev.label} date,{' '}
        <a class="fig" data-receipt={doc.doc_id} href={`/country/${iso3}/#treaty`}>{ev.display}</a>, in the
        treaty line.
      </p>
    </li>
    <li>
      <h2><a href={`/receipt/${iso3}/${doc.doc_id}/`}>Its receipt</a></h2>
      <p>
        {doc.title} — the recorded state, the{' '}
        <a href={`/receipt/${iso3}/${doc.doc_id}/#quote`}>page-one quote</a>, and the SHA-256 of the file as fetched, at
        one URL of its own.
      </p>
    </li>
    <li>
      <h2><a href={`/receipt/${iso3}/${doc.doc_id}/#sha256`}>The hash</a></h2>
      <p>The SHA-256 of the fetched file: the identity this record rests on.</p>
    </li>
    <li>
      <h2><a href="/author/">Your own sentence</a></h2>
      <p>
        Authoring: cite a receipt token in a .docx draft and the checker returns it with a status
        comment — anchored, outdated, or unsupported — on each cited sentence. The grammar, the
        status rules and the CLI are documented at <a href="/author/">/author/</a>; no upload UI is
        mocked, because this site is static.
      </p>
    </li>
  </ol>
</Base>
