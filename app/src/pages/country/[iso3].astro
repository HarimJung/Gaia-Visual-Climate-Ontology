---
// Country ledger (AD-10). First three seconds, zero clicks: country name,
// treaty status in one line, next relevant date, and the completeness strip.
// One static route per country view; everything on this screen comes from the
// view JSON plus the index/census the door serves (R11); no country identity
// lives in this file (R1).
import Base from '../../layouts/Base.astro';
import StateLegend from '../../components/StateLegend.astro';
import SceneStage from '../../components/SceneStage.astro';
import RecordStage from '../../components/RecordStage.astro';
import { views, census, countryEntry, REPO_BLOB } from '../../lib/data.mjs';
import { sceneDataFor } from '../../lib/scene-data.mjs';
import '../../styles/scene.css';
import '../../styles/stage.css';

export function getStaticPaths() {
  return views.map((view) => ({
    params: { iso3: view.country.iso3.toLowerCase() },
    props: { view },
  }));
}

const { view } = Astro.props;
const iso3 = view.country.iso3.toLowerCase();
const entry = countryEntry(view.country.iso3);
const c = entry.counts;
const ledgerUrl = REPO_BLOB + entry.ledger;
// The resting instrument (AD-6R): mounts only when scrolled near; the
// server-rendered dial is the baseline. A tap on any part jumps to the rows.
const scene = { ...sceneDataFor(view, entry), selectHref: '#ledger-h' };
---

<Base title={`${view.country.name_en} — ledger`}>
  <section class="head">
    <p class="crumb"><a href={`/ledger/#c-${iso3}`}>← world ledger</a></p>
    {/* the name this record is known by travels here from the ledger row the
        reader clicked: the same element, carried across the navigation */}
    <h1 style={`view-transition-name:n-${view.country.iso3.toLowerCase()}`}>{view.country.name_en}</h1>

    <p class="treaty" id="treaty">
      {view.treaty_status.length === 0 && (
        <span class="muted">No treaty events on record in this runtime for this country.</span>
      )}
      {
        view.treaty_status.map((t, i) => (
          <>
            {i > 0 && (
              <span class="sep" aria-hidden="true">
                ·
              </span>
            )}
            <b>{t.treaty_label}</b>{' '}
            {/* the explicit {' '} is the only space the compiler keeps: source
                newlines around the anchor are stripped, which ran the event
                word straight into its date on every country page */}
            {t.events.map((ev, j) => (
              <>{j > 0 && ', '}{ev.label}{' '}<a class="fig" data-receipt={t.receipt} href={`/receipt/${iso3}/${t.receipt}/`}>{ev.display}</a></>
            ))}
          </>
        ))
      }
    </p>

    <p class="nextdate" id="next-date">
      <span class="lbl">Next relevant date</span>
      {
        view.next_date.date ? (
          <>
            <a class="fig" data-receipt={view.next_date.receipt} href={`/receipt/${iso3}/${view.next_date.receipt}/`}><time datetime={view.next_date.date}>{view.next_date.date}</time></a>
            {view.next_date.label && <span class="reason">{view.next_date.label}</span>}
          </>
        ) : (
          <>
            <span class={`chip chip-${view.next_date.state}`}>{view.next_date.state}</span>
            <span class="reason">{view.next_date.reason}</span>
          </>
        )
      }
    </p>

    <section class="stripsec" id="strip" aria-labelledby="strip-h">
      <h2 id="strip-h">{view.strip.heading}</h2>
      {
        c.documents_on_record > 0 && (
          <div class="strip">
            {
              /* all four states show, zeros included at a minimum width: zero
                 is a reading, and the key below names four materials, so the
                 object it describes has four */
              view.strip.segments.map((s) => (
                <div
                  class={`seg seg-${s.state}${c[s.census_key] > 0 ? '' : ' seg-zero'}`}
                  style={`flex-grow:${c[s.census_key]}`}
                  title={`${s.state} ${c[s.census_key]}`}
                />
              ))
            }
          </div>
        )
      }
      <ul class="strip-key">
        {
          /* the state's own name is the one vocabulary: the view also carries
             a display label that renamed "observed" to "evidenced", which put
             two names for one state 200px apart on this page */
          view.strip.segments.map((s) => (
            <li>
              <span class={`sw sw-${s.state}`} aria-hidden="true" />
              {s.state}{' '}
              <a class="fig" data-census={s.census_key} href={`#census-${s.census_key}`}>
                {c[s.census_key]}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="muted">{view.strip.note}</p>
    </section>
  </section>

  {/* The instrument sits under the zero-click trio (AD-10 stays first in the
      DOM and complete without JS) and above the rows it is built from. */}
  <section class="dial-stage" aria-label="The record as an instrument">
    <SceneStage
      scene={scene}
      counts={c}
      rows={view.rows}
      dialHref="#census-documents_with_bytes"
      onRecordHref="#census-documents_on_record"
      start={100}
    />
  </section>

  {/* The record stage: the same documents, morphed stage by stage — the
      predecessor's country choreography, re-anchored on what is held. */}
  <RecordStage view={view} counts={c} iso3={iso3} />

  <section aria-labelledby="ledger-h">
    <h2 class="sec" id="ledger-h">
      Documents on record:{' '}
      <a class="fig" data-census="documents_on_record" href="#census-documents_on_record">{c.documents_on_record}</a>
    </h2>
    {
      view.rows.length === 0 ? (
        <div class="void">
          <span class="chip chip-unknown">no documents held</span>
          <span class="reason"> This runtime holds no document rows for this country; the void is stated, not hidden.</span>
        </div>
      ) : (
        <div class="tablewrap">
          <table class="table">
            <thead>
              <tr>
                <th scope="col">Document</th>
                <th scope="col">Type</th>
                <th scope="col">Date</th>
                <th scope="col">State</th>
                <th scope="col">Bytes</th>
              </tr>
            </thead>
            <tbody>
              {
                view.rows.map((r) => (
                  <tr id={`row-${r.doc_id}`}>
                    <td>
                      <span class="doc-title">
                        <a href={`/receipt/${iso3}/${r.doc_id}/`} data-receipt={r.doc_id}>
                          {r.title}
                        </a>
                      </span>
                      {r.state === 'unknown' && !r.refusal && <p class="rowmeta">{r.state_reason}</p>}
                      {r.refusal && (
                        <div class="refusal">
                          <span class="tag">REFUSED — figure extraction</span>“
                          <a href={`/receipt/${iso3}/${r.doc_id}/#state`} data-receipt={r.doc_id}>
                            {r.refusal}
                          </a>
                          ”
                        </div>
                      )}
                      {r.receipt_scope && <p class="rowmeta">{r.receipt_scope}</p>}
                    </td>
                    <td class="mono" style="font-size:13px">
                      {r.doc_type}
                    </td>
                    <td>
                      <a class="fig" data-receipt={r.doc_id} href={`/receipt/${iso3}/${r.doc_id}/`}>
                        {r.date}
                      </a>
                    </td>
                    <td>
                      <span class={`chip chip-${r.state}`}>{r.state}</span>
                    </td>
                    <td>
                      {r.sha256 ? (
                        <a class="fig" data-receipt={r.doc_id} href={`/receipt/${iso3}/${r.doc_id}/#sha256`}>
                          {r.sha256.slice(0, 8)}…
                        </a>
                      ) : (
                        <a class="chip chip-unknown" data-receipt={r.doc_id} href={`/receipt/${iso3}/${r.doc_id}/#sha256`}>
                          no bytes held
                        </a>
                      )}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      )
    }
  </section>

  <section aria-labelledby="census-h" id="census-sec">
    <h2 class="sec" id="census-h">Census</h2>
    <p class="census-src">
      Every count below is recomputable from this country's ledger:{' '}
      <a href={ledgerUrl} class="mono" style="font-size:13px">{entry.ledger}</a> (as of{' '}
      <span class="mono" data-meta="as_of">{view.as_of}</span>).
    </p>
    <div class="tablewrap">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Key</th>
            <th scope="col" class="num">Count</th>
            <th scope="col">Derivation</th>
          </tr>
        </thead>
        <tbody>
          {
            Object.entries(c).map(([k, v]) => (
              <tr id={`census-${k}`}>
                <td class="ckey">{k}</td>
                <td class="num">
                  <a class="fig" data-census={k} href={ledgerUrl}>
                    {v}
                  </a>
                </td>
                <td class="muted">{census.derivations[k]}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <StateLegend counts={c} />
  </section>
</Base>

<script>
  // The record stage's stepper: one IntersectionObserver over viewport-tall
  // tracks. With JavaScript off the stage rests on its last step — the
  // engraved dial inside its ring — and every card reads as plain prose.
  import { mountRecordStage } from '../../lib/scene/record-stage.mjs';
  const section = document.querySelector('[data-record]');
  if (section) mountRecordStage(section);
</script>
