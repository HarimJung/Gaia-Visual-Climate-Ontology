---
// The front door is now the story: cover → the world materializes (beads fly
// from map centroids into formations) → zoom to one record (the 3D instrument
// assembles under a pinned scrub) → one document opens to its hash → the
// machine's voids → the single action, into /ledger/ and the walked country.
// The world-ledger table lives at /ledger/. Everything here comes through the
// view door (R11); no country identity lives in this file (R1); every figure
// rendered is a census value inside a link (R6). The rich layers load
// progressively: with JavaScript off the page is complete — server-rendered
// map, dial and full text (AD-6R baseline).
import Base from '../layouts/Base.astro';
import SceneStage from '../components/SceneStage.astro';
import { views, census, countryEntry, fmt, richestView, REPO_BLOB } from '../lib/data.mjs';
import { sceneDataFor } from '../lib/scene-data.mjs';
import { STORY, WORLD_STEPS, MACHINE_CARDS } from '../lib/story-content.mjs';
import { binGeom, blockGeom, plotGeom } from '../lib/scene/world-stage.mjs';
import basemap from '../../public/data/basemap.json';
import '../styles/scene.css';
import '../styles/stage.css';

const ledgerUrl = REPO_BLOB + census.ledger;

// ── World stage data: one bead and one column per country ────────────────
// Centroid of the largest subpath of a country's base-map shape (predecessor
// boxOf: Fiji wraps the dateline, large unions centre on their main body).
function boxOf(d) {
  let best = { x: 0, y: 0, w: 0, h: 0 };
  for (const sub of d.split('M')) {
    const n = sub.match(/-?\d+(?:\.\d+)?/g);
    if (!n || n.length < 4) continue;
    let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
    for (let i = 0; i + 1 < n.length; i += 2) {
      const x = +n[i], y = +n[i + 1];
      if (x < x0) x0 = x; if (x > x1) x1 = x; if (y < y0) y0 = y; if (y > y1) y1 = y;
    }
    const b = { x: x0, y: y0, w: x1 - x0, h: y1 - y0 };
    if (b.w * b.h > best.w * best.h) best = b;
  }
  return best;
}
// A frame shaped for the column it sits in: the stage is sticky beside a text
// column, so a 1.56:1 viewBox rendered a 339px band of marks adrift in a 900px
// viewport. At 1.19:1 the stage fills the screen it is pinned to.
const W = 1000, H = 840, MAP_TY = Math.round((H - basemap.height) / 2), BASE = 560;
// The reason families: every distinct verbatim reason this runtime recorded
// for an unknown, in the order the rows carry them. They become the blocks of
// the voids step and its key — "unknown" as a taxonomy with named families
// rather than one shrug (predecessor world-stage HATCH families).
// A reason's leading clause is the family: the rest of the sentence names the
// one document it was recorded on (a file name, a capture id), so grouping on
// the whole string would give one family per row. The clause is the runtime's
// own words, cut at its own punctuation — never a name invented for it.
// A record is filed under the family of its FIRST recorded unknown, which is
// exactly the mark the stage draws for it, so the key's count and the block's
// marks are the same thing counted once.
const famKey = (s) => s.split(/[:;]/)[0].trim();
const fams = [];
for (const v of views) {
  const r = v.rows.find((row) => row.state === 'unknown' && row.state_reason);
  if (!r) continue;
  const key = famKey(r.state_reason);
  let f = fams.find((e) => e.key === key);
  if (!f) {
    f = { key, reason: r.state_reason, iso3: v.country.iso3.toLowerCase(), doc_id: r.doc_id, n: 0 };
    fams.push(f);
  }
  f.n += 1;
}
// biggest families first: the blocks read as a distribution, not as log order
fams.sort((a, b) => b.n - a.n);
const famOf = (v) => {
  const r = v.rows.find((row) => row.state === 'unknown' && row.state_reason);
  return r ? fams.findIndex((f) => f.key === famKey(r.state_reason)) : -1;
};
const worldData = {
  w: W, h: H, mapTY: MAP_TY, base: BASE, fams: fams.length,
  countries: views.map((v) => {
    const shape = basemap.shapes[v.country.iso3];
    const b = shape ? boxOf(shape) : null;
    const c = countryEntry(v.country.iso3).counts;
    return {
      i: v.country.iso3,
      x: b ? Math.round((b.x + b.w / 2) * 10) / 10 : null,
      y: b ? Math.round((b.y + b.h / 2) * 10) / 10 : null,
      p: v.treaty_status.length > 0 ? 1 : 0,
      b: c.documents_with_bytes,
      o: c.documents_without_bytes,
      u: c.states_unknown,
      f: famOf(v),
    };
  }),
};
// Server-rendered resting state = the 'map' layout; the cell pool parks at its
// bin place (the geometry the client module derives from the same island).
const mapPos = (c, i) => (c.x == null
  ? { x: 40 + (i % 60) * 6, y: H - 14 }
  : { x: c.x, y: MAP_TY + c.y });
const BG = binGeom(worldData), BLK = blockGeom(worldData), PLT = plotGeom(worldData);
// Block labels wrap to the block's own width. The face is mono at 26 user
// units, so one character advances ~15.6 units; measuring with anything
// narrower runs a label across its neighbour's block, which is what a
// 12-character word did here. Lines that still do not fit are cut, and the
// reason stays verbatim in the step card's key beside the stage.
const FAM_CH = 15.6;
const famLines = (s) => {
  const per = Math.max(5, Math.floor((BLK.colW - 18) / FAM_CH));
  const out = [];
  let line = '';
  for (const word of String(s).split(/\s+/)) {
    if (!line) line = word;
    else if ((line + ' ' + word).length <= per) line += ' ' + word;
    else { out.push(line); line = word; }
    if (out.length === 3) break;
  }
  if (out.length < 3 && line) out.push(line);
  return out.map((l) => (l.length > per ? l.slice(0, Math.max(1, per - 1)) + '…' : l));
};
const binStack = new Map();
const binAt = (c) => {
  const k = binStack.get(c.b) ?? 0;
  binStack.set(c.b, k + 1);
  return {
    x: BG.x0 + c.b * BG.pitch + ((k % BG.cols) - (BG.cols - 1) / 2) * BG.step,
    y: BG.base - Math.floor(k / BG.cols) * BG.step,
  };
};
const binHome = new Map(worldData.countries.map((c) => [c.i, binAt(c)]));

// Step figures resolve against the census through the door; graph-level
// counters link to the ledger file they are recomputed from (R6). A key the
// active census does not carry (the fixture build has no graph counters)
// renders nothing — a figure is never invented to fill a slot (R5).
const figOf = (f) =>
  f.scope === 'graph'
    ? { value: census.graph?.[f.key], href: ledgerUrl }
    : { value: census.counts[f.key], href: `/ledger/#census-${f.key}` };

// ── The walked record: the richest in the data (same derivation as /demo/) ──
const walked = richestView();
const iso3 = walked.country.iso3.toLowerCase();
const entry = countryEntry(walked.country.iso3);
const scene = { ...sceneDataFor(walked, entry), selectHref: `/country/${iso3}/` };
// Predecessor pacing: a screen of lead, a screen of hold, and the scrub over
// the middle. Each chapter owns an equal slice of the scrub (trackToProgress
// maps even track position to uneven chapter time), so a card sits at the
// centre of its own slice and no stretch of scroll buys nothing.
const SCREENS = 10;
const CHAPTERS = MACHINE_CARDS.length;
const cardTop = (k) => (1 + ((k + 0.5) / CHAPTERS) * (SCREENS - 2)) / SCREENS;
const cardFig = (key) => ({ value: entry.counts[key], href: `/country/${iso3}/#census-${key}` });
// the hero caption numbers the chapter the opening is playing, as the shipped
// product's does: "03 · …". Two digits, so the row does not reflow at ten.
const chapterNo = (phase) => String(phase + 1).padStart(2, '0');

// ── The hero's glass card and legend (unchanged wording) ──────────────────
const c = entry.counts;
// the reason is the first unread row's own recorded words, verbatim, with the
// document it was recorded on linked. No row carries one: the card carries
// only the sentence, and nothing is written to fill the slot.
const unread = walked.rows.find((r) => !r.sha256 && r.state_reason) ?? null;
// the four-state legend over the world census. The second word is the READING
// in plain English — what the state means for a document.
const legend = [
  { state: 'observed', reading: 'read', key: 'states_observed' },
  { state: 'pledged', reading: 'pledged, not measured', key: 'states_pledged' },
  { state: 'unknown', reading: 'on file, not read', key: 'states_unknown' },
  { state: 'absent', reading: 'confirmed absent', key: 'states_absent' },
];

// ── One document opens: the walked record's quoted, hashed row ────────────
const doc = walked.rows.find((r) => r.quote && r.sha256);
const treaty = walked.treaty_status.find((t) => t.receipt === doc.doc_id);
const ev = treaty?.events[0];

// ── The voids: the one refusal on record, verbatim, from whichever view
// holds it (derived, never named) ──────────────────────────────────────────
let refusal = null;
for (const v of views) {
  const r = v.rows.find((row) => row.refusal);
  if (r) { refusal = { row: r, view: v, iso3: v.country.iso3.toLowerCase() }; break; }
}
---

<Base title="National Climate Record Runtime">
  {/* THE HERO — the shipped product's opening: the machine itself, mounted
      from the same SceneStage the country pages use (never a second copy of
      it), with the server-rendered dial as its fallback, so the page is
      complete with JavaScript off and when WebGL is lost. The opening plays
      the assembly once and names the chapter it is in; the scroll chapter
      further down still drives the same machine through the whole story. */}
  <section class="hero-machine" data-hero aria-label="One record, as a machine">
    <div class="hero-copy">
      <p class="eyebrow">
        <span>{STORY.eyebrow} · as of <span data-meta="as_of">{census.as_of}</span></span>
      </p>
      <h1>{STORY.title}</h1>
      <p class="hero-lede">{STORY.lede}</p>
    </div>

    <div class="hero-right">
      <div class="dial-stage hero-stage">
        <SceneStage
          scene={scene}
          counts={entry.counts}
          rows={walked.rows}
          dialHref={`/country/${iso3}/#census-documents_with_bytes`}
          onRecordHref={`/country/${iso3}/#census-documents_on_record`}
          start={0}
        />
      </div>
      {/* the caption row: which chapter the opening is playing, what it says,
          and the figures that chapter rests on. A chapter this record holds no
          figure for states none — the plate, the sockets and the support cog
          carry no count here rather than borrow one. With JavaScript off the
          first chapter's caption is the one that shows. */}
      <div class="hcaps">
        <span class="hdots" aria-hidden="true">
          {MACHINE_CARDS.map((card) => <span class="hdot" data-hdot={card.phase} />)}
        </span>
        <div class="hcapcol">
          {
            MACHINE_CARDS.map((card) => (
              <p class={`hcap${card.phase === 0 ? ' is-on' : ''}`} data-hcap={card.phase}>
                <a class="hcap-t" href="#machine">{chapterNo(card.phase)} · {card.title}</a>
                <span class="hcap-b">{card.body}</span>
                {card.phase === 2 && (
                  <span class="hcap-f">
                    <a class="fig" data-census="states_pledged" href={cardFig('states_pledged').href}>
                      {cardFig('states_pledged').value}
                    </a>{' '}
                    pledge figures read from this record — the ring stays ghosted.
                  </span>
                )}
                {card.phase === 3 && (
                  <span class="hcap-f">
                    <a class="fig" data-census="documents_with_bytes" href={cardFig('documents_with_bytes').href}>
                      {cardFig('documents_with_bytes').value}
                    </a>{' '}
                    hashed of{' '}
                    <a class="fig" data-census="documents_on_record" href={cardFig('documents_on_record').href}>
                      {cardFig('documents_on_record').value}
                    </a>{' '}
                    on record for this country.
                  </span>
                )}
              </p>
            ))
          }
        </div>
      </div>
    </div>

    <div class="hero-aside">
      {/* the glass card: one true sentence, every figure inside its link */}
      <div class="hcard">
        <div class="hcard-head">
          <span class="hcard-eyebrow">what this runtime holds</span>
          <span class="hcard-tag">counted</span>
        </div>
        <div class="hcard-body">
          On <a class="hcard-strong" href={`/country/${iso3}/`}>{walked.country.name_en}</a>’s record this
          runtime holds{' '}
          <a data-census="documents_on_record" href={`/country/${iso3}/#census-documents_on_record`}>{fmt(c.documents_on_record)}</a>{' '}
          documents; the bytes of{' '}
          <a data-census="documents_with_bytes" href={`/country/${iso3}/#census-documents_with_bytes`}>{fmt(c.documents_with_bytes)}</a>{' '}
          are held and hashed here, and{' '}
          <a data-census="documents_without_bytes" href={`/country/${iso3}/#census-documents_without_bytes`}>{fmt(c.documents_without_bytes)}</a>{' '}
          are on record without them.
        </div>
        {
          unread && (
            <p class="hcard-reason reason">
              “{unread.state_reason}” —{' '}
              <a href={`/receipt/${iso3}/${unread.doc_id}/#state`} data-receipt={unread.doc_id}>
                {unread.title}
              </a>
            </p>
          )
        }
      </div>

      {/* the legend: the state, its reading in plain English, its count */}
      <ul class="hlegend">
        {
          legend.map((s) => (
            <li>
              <span class={`sw sw-${s.state}`} aria-hidden="true" />
              <span class="hlbl">
                {s.state} · {s.reading}{' '}
                <a data-census={s.key} href={`/ledger/#census-${s.key}`}>{fmt(census.counts[s.key])}</a>
              </span>
            </li>
          ))
        }
      </ul>

      <p class="hero-action">
        <a href="/ledger/">The world ledger holds every row →</a>
      </p>
    </div>
  </section>

  <section class="scrolly" id="world" data-world aria-label="The world's records, step by step">
    <div class="wsteps">
      {
        WORLD_STEPS.map((s) => (
          <div class="wstep" data-step={s.step}>
            <h2>{s.title}</h2>
            <p>{s.body}</p>
            <div class="figrow">
              {s.figs
                .map((f) => ({ f, r: figOf(f) }))
                .filter(({ r }) => r.value != null)
                .map(({ f, r }) => (
                  <span>
                    <a class="fig" data-census={f.key} href={r.href}>
                      {fmt(r.value)}
                    </a>
                    {f.label}
                  </span>
                ))}
            </div>
            {/* the family key: one row per recorded reason, the reason
                verbatim and linked to a receipt it was read on, its count
                linked to the ledger file it is recomputable from (R6) */}
            {s.families && (
              <ul class="famrow">
                {fams.map((f) => (
                  <li>
                    <span>
                      <a class="fig" href={ledgerUrl}>{fmt(f.n)}</a> records ·{' '}
                      <a class="reason" href={`/receipt/${f.iso3}/${f.doc_id}/#state`} data-receipt={f.doc_id}>
                        “{f.reason}”
                      </a>
                    </span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </div>
    <div class="wstage" data-wstage>
      <div class="stage" aria-hidden="true">
        <svg viewBox={`0 0 ${W} ${H}`}>
          <defs>
            {/* Absence is a material, not a lighter grey: a record holding no
                hashed bytes is hatched at the canon's own bytes-not-held
                angle (encodings_record.csv → texture.hatch-135).
                This tile is the generated one's twin and not a second canon:
                same two tokens, same angle, same 1.4-to-5 duty. It has to be
                declared locally because these cells are placed AND SIZED by
                transform (WebKit animates transforms, not geometry attributes),
                and a userSpaceOnUse tile — which is what engine/generated/
                textures.svg must use to work anywhere else — would be
                multiplied by each cell's own scale and render as one enormous
                diagonal. objectBoundingBox is the only unit that survives
                that, so the marks the layout does NOT scale (the dial's
                bores, the record stage's stamps) use url(#t-hatch-45) and
                friends from the generated defs directly. */}
            <pattern id="w-hatch-135" width=".34" height=".34" patternUnits="objectBoundingBox" patternContentUnits="objectBoundingBox">
              <rect width=".34" height=".34" fill="var(--paper-sunken)"></rect>
              <path d="M0,0 L.34,.34 M-.17,.17 L.17,.51" stroke="var(--ink-4)" stroke-width=".1" fill="none"></path>
            </pattern>
          </defs>
          <g class="stage-map" style={`transform:translate(0px,${MAP_TY}px)`}>
            {
              Object.entries(basemap.shapes).map(([iso, d]) => (
                <path d={d} class={worldData.countries.some((c) => c.i === iso) ? 'c' : ''} />
              ))
            }
            {/* records the base map holds no shape for rest in a row below
                the stage; the label travels with the map and fades with it */}
            <text x="40" y={H - 26 - MAP_TY}>records with no base-map shape ↓</text>
          </g>
          {/* the parties step's apart group: records with no treaty event on
              the depositary's list stand in a labelled satellite one pitch off
              the roster block, so standing apart reads intentional. Placed by
              world-stage on that step, and only if any exist. */}
          <g class="stage-apart" aria-hidden="true">
            <text x="858" y="68" text-anchor="middle">no treaty</text>
            <text x="858" y="96" text-anchor="middle">event on</text>
            <text x="858" y="124" text-anchor="middle">record</text>
            <line x1="858" y1="136" x2="858" y2="156" />
          </g>

          {/* ── per-step annotation: word labels only, so no figure is ever
                 drawn here outside its link (R6). The figures live in the
                 step cards and the family key, each census- or receipt-linked. */}
          <g class="stage-ann g-bytes">
            <line class="w-axis" x1={BG.x0 - BG.pitch / 2} y1={BG.base + BG.step} x2={BG.x0 + (BG.bins - 0.5) * BG.pitch} y2={BG.base + BG.step} />
            {BG.sizes.map((_, b) => (
              <a href="/ledger/#census-documents_with_bytes">
                <text x={BG.x0 + b * BG.pitch} y={BG.base + BG.step + 34} text-anchor="middle">{b}</text>
              </a>
            ))}
            <text x={BG.x0 - BG.pitch / 2} y={BG.top - 26} class="w-blk">documents hashed, per record →</text>
          </g>
          <g class="stage-ann g-voids">
            {/* one block label per family, on its own tick line: the label is
                the recorded reason's leading clause, wrapped, and it links to
                a receipt the reason was read on */}
            {fams.concat([{ key: 'nothing unknown on record', iso3: null, doc_id: null }]).map((f, b) => {
              const x = BLK.x0 + b * BLK.colW - 8;
              const lines = famLines(f.key);
              const label = lines.map((l, j) => (
                <text x={x} y={BLK.top - 42 - (lines.length - 1 - j) * 28}>{l}</text>
              ));
              return (
                <g>
                  <line class="w-axis" x1={x} y1={BLK.top - 30} x2={x} y2={BLK.top - 10} />
                  {f.doc_id ? (
                    <a href={`/receipt/${f.iso3}/${f.doc_id}/#state`} data-receipt={f.doc_id}>{label}</a>
                  ) : label}
                </g>
              );
            })}
          </g>
          <g class="stage-ann g-scatter">
            <line class="w-axis" x1={PLT.l - 16} y1={PLT.b + 18} x2={PLT.r} y2={PLT.b + 18} />
            <line class="w-axis" x1={PLT.l - 16} y1={PLT.t - 14} x2={PLT.l - 16} y2={PLT.b + 18} />
            <text x={PLT.l - 16} y={PLT.t - 40} class="w-blk">↑ documents hashed</text>
            <text x={PLT.r} y={PLT.b + 48} text-anchor="end" class="w-blk">documents on record →</text>
            {/* the break rule and the lane: a record with no bytes held at all
                is counted in its own place, never collapsed onto the axis */}
            <line class="w-axis" x1={PLT.l - 16} y1={PLT.lane - 34} x2={PLT.r} y2={PLT.lane - 34} stroke-dasharray="6 5" />
            <text x={PLT.l - 16} y={PLT.lane - 12} class="w-blk">no bytes held at all</text>
          </g>

          <g>
            {
              worldData.countries.map((c) => {
                const p = binHome.get(c.i);
                return (
                  <rect
                    data-cell={c.i}
                    x="-0.5"
                    y="-0.5"
                    width="1"
                    height="1"
                    class="stage-cell off"
                    style={`transform:translate(${p.x.toFixed(1)}px,${p.y.toFixed(1)}px) scale(.001,.001)`}
                  />
                );
              })
            }
          </g>
          <g>
            {
              worldData.countries.map((c, i) => {
                const p = mapPos(c, i);
                return (
                  <circle data-bead={c.i} r="2.6" class="stage-bead" style={`transform:translate(${p.x}px,${p.y}px)`} />
                );
              })
            }
          </g>
        </svg>
      </div>
      <p class="stage-caption">
        One mark per country on record.{' '}
        {/* the base-map credit belongs to the step that draws the base map;
            with JavaScript off no step class is set and the map is what the
            page rests on, so the credit shows */}
        <span class="cap-map">
          Base map: Natural Earth (public domain), Equal Earth projection — a base map, not a
          measurement.{' '}
        </span>
        Counts from{' '}
        <a href={ledgerUrl} class="mono" style="font-size:12.5px">{census.ledger}</a>, as of{' '}
        <span class="mono" data-meta="as_of">{census.as_of}</span>.
      </p>
      <script type="application/json" data-world-data set:html={JSON.stringify(worldData)} />
    </div>
  </section>

  <section
    class="scroll-chapter"
    id="machine"
    data-machine
    style={`height:${SCREENS * 100}svh`}
    aria-label="One record, assembled chapter by chapter"
  >
    <div class="scroll-pin">
      <div class="stage-heading">
        <span>{STORY.machineHeading} — <a href={`/country/${iso3}/`} style="pointer-events:auto">{walked.country.name_en}</a></span>
      </div>
      {/* the chapter row: which chapter of the assembly is on screen, and the
          way back to the first (predecessor instrument-hero's dot row and its
          replay, kept while the autoplay stays replaced by the scrub) */}
      <div class="chapterrow" data-chapters>
        {MACHINE_CARDS.map((card) => <span class="dot" data-dot={card.phase} />)}
        <button type="button" class="replay" data-replay>run the assembly again</button>
      </div>
      <span class="stage-afford">drag to turn · tap a part</span>
      <SceneStage
        scene={scene}
        counts={entry.counts}
        rows={walked.rows}
        dialHref={`/country/${iso3}/#census-documents_with_bytes`}
        onRecordHref={`/country/${iso3}/#census-documents_on_record`}
        start={0}
      />
    </div>
    <div class="scene-cards">
      {
        MACHINE_CARDS.map((card) => (
          <div class="scene-card" data-phase={card.phase} style={`top:${(cardTop(card.phase) * 100).toFixed(2)}%`}>
            <span class="eyebrow">{card.eyebrow}</span>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
            {card.phase === 3 && (
              <p class="cardfigs">
                <a class="fig" data-census="documents_with_bytes" href={`/country/${iso3}/#census-documents_with_bytes`}>
                  {cardFig('documents_with_bytes').value}
                </a>{' '}
                hashed of{' '}
                <a class="fig" data-census="documents_on_record" href={`/country/${iso3}/#census-documents_on_record`}>
                  {cardFig('documents_on_record').value}
                </a>{' '}
                on record for this country.
              </p>
            )}
          </div>
        ))
      }
    </div>
  </section>

  <section class="docopen" id="document">
    <p class="eyebrow doc-eyebrow">{STORY.docEyebrow}</p>
    <h2>{STORY.docTitle}</h2>
    <p class="docbody">{STORY.docBody}</p>
    <div class="docchain">
      {/* these three are labels on one section, not three headings of their
          own: h3 under the section's h2, which is what they read as */}
      <div class="rblock">
        <h3>Document</h3>
        <p class="doc-title">
          <a href={`/receipt/${iso3}/${doc.doc_id}/`} data-receipt={doc.doc_id}>{doc.title}</a>
        </p>
        {
          ev && treaty && (
            <p class="docline">
              {treaty.treaty_label} {ev.label}{' '}
              <a class="fig" data-receipt={doc.doc_id} href={`/country/${iso3}/#treaty`}>
                {ev.display}
              </a>
            </p>
          )
        }
      </div>
      <div class="rblock">
        <h3>Verbatim quote</h3>
        <p class="quote"><span class="qtext">{doc.quote.text}</span></p>
      </div>
      {/* the case-back, turned over: the three things provenance is made of,
          on one plate (predecessor Motion.dc.html 05). Both faces are plain
          stacked blocks until the script marks the block ready. */}
      <div class="rblock" id="story-sha256">
        <h3>SHA-256 — the case-back</h3>
        <div class="caseback" data-caseback>
          <div class="cb-plate">
            <div class="cb-face cb-front">
              <p class="hash"><a data-receipt={doc.doc_id} href={`/receipt/${iso3}/${doc.doc_id}/#sha256`}>{doc.sha256}</a></p>
            </div>
            <div class="cb-face cb-back">
              <dl>
                <dt>source</dt>
                <dd>
                  {doc.source_url
                    ? <a href={doc.source_url}>{doc.source_url}</a>
                    : <span class="chip chip-absent">none recorded</span>}
                </dd>
                <dt>run time</dt>
                <dd><span data-meta="as_of">{census.as_of}</span></dd>
                <dt>checksum</dt>
                <dd class="hash">
                  <a data-receipt={doc.doc_id} href={`/receipt/${iso3}/${doc.doc_id}/#sha256`}>{doc.sha256}</a>
                </dd>
              </dl>
            </div>
          </div>
        </div>
        <p class="muted">The identity this record rests on: the hash of the fetched file itself.</p>
      </div>
    </div>
  </section>

  <section class="voids" id="voids">
    <p class="eyebrow doc-eyebrow">{STORY.voidsEyebrow}</p>
    <h2>{STORY.voidsTitle}</h2>
    <p class="docbody">{STORY.voidsBody}</p>
    {
      refusal && (
        <div class="refusal">
          <span class="tag">REFUSED — figure extraction · {refusal.view.country.name_en}</span>“
          <a href={`/receipt/${refusal.iso3}/${refusal.row.doc_id}/#state`} data-receipt={refusal.row.doc_id}>
            {refusal.row.refusal}
          </a>
          ”
        </div>
      )
    }
    <div class="figrow">
      <span>
        <a class="fig" data-census="states_pledged" href="/ledger/#census-states_pledged">
          {fmt(census.counts.states_pledged)}
        </a>
        pledge figures read — every target ring stands ghosted
      </span>
      <span>
        <a class="fig" data-census="states_unknown" href="/ledger/#census-states_unknown">
          {fmt(census.counts.states_unknown)}
        </a>
        states unknown — each an empty bore, each with its reason
      </span>
    </div>
    <p class="muted">{STORY.voidsNote}</p>
  </section>

  <section class="closer" id="close">
    <p class="eyebrow doc-eyebrow">{STORY.closeEyebrow}</p>
    <h2>{STORY.closeTitle}</h2>
    <p class="docbody">{STORY.closeBody}</p>
    <p class="ways">
      <a class="way" href="/ledger/">{STORY.ctaLedger} →</a>
      <a class="way" href={`/country/${iso3}/`}>{STORY.ctaCountry}: {walked.country.name_en} →</a>
    </p>
  </section>
</Base>

<style>
  /* The story page's own blocks, on the ported kit: the chrome, the eyebrow,
     the chapter heads, the figures, the ways and the four materials all come
     from styles/site.css, which is the shipped product's stylesheet. Only
     what is particular to this page is declared here. */
  /* ── THE HERO ────────────────────────────────────────────────────────
     Their proportion: the words on the left, the machine on the right at
     roughly half the frame, the caption row under it. The stage is the
     shipped .dial-stage box (so .scene-stage still fills it), only taller,
     because here the machine is the first thing on the page. */
  .hero-machine {
    display: grid; align-items: center;
    grid-template-columns: 5fr 7fr;
    grid-template-areas: "copy stage" "aside stage";
    gap: var(--s5) clamp(28px, 3.6vw, 60px);
    padding: clamp(20px, 4svh, 48px) 0 clamp(28px, 5svh, 56px);
  }
  .hero-copy { grid-area: copy; align-self: end; min-width: 0; }
  .hero-right { grid-area: stage; min-width: 0; }
  .hero-aside { grid-area: aside; align-self: start; min-width: 0; }
  .hero-copy h1 { margin: var(--s3) 0 var(--s4); font: 800 clamp(40px, 4.4vw, 66px)/1 var(--font-display); letter-spacing: -.03em; max-width: 14ch; }
  .hero-lede { margin: 0; max-width: 40ch; font-size: var(--t4); line-height: 1.55; color: var(--ink-2); }
  .hero-stage { aspect-ratio: 1 / 1.08; max-height: min(74svh, 660px); min-height: 360px; margin: 0; }

  /* the caption row: the dots, then the chapter the opening is playing */
  .hcaps { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--s4); margin-top: var(--s2); padding-top: var(--s4); border-top: 1px solid var(--rule); }
  .hdots { display: flex; align-items: center; gap: 7px; padding-top: 7px; }
  .hdot { width: 6px; height: 6px; border-radius: 50%; background: var(--rule-strong); transition: background var(--dur) var(--ease); }
  .hdot.is-done { background: var(--ink-4); }
  .hdot.is-on { background: var(--un); }
  /* one caption per chapter, server-rendered; CSS alone shows the first, so
     the row is complete and honest with no script at all */
  .hcap { display: none; margin: 0; }
  .hcap.is-on { display: block; }
  .hcap-t { font: 600 var(--t3)/1.35 var(--font-sans); color: var(--ink); text-decoration-color: var(--rule); font-variant-numeric: tabular-nums; }
  .hcap-b { display: block; margin-top: 5px; max-width: 58ch; font-size: var(--t2); line-height: 1.5; color: var(--ink-3); }
  .hcap-f { display: block; margin-top: 7px; font-size: var(--t1); line-height: 1.5; color: var(--ink-3); }

  /* the glass card: a raised sheet carrying one true sentence */
  .hcard { padding: var(--s4) var(--s4) var(--s4) var(--s5); border: 1px solid var(--rule); border-left: 4px solid var(--un); background: var(--paper-raised); box-shadow: var(--shadow-1); }
  .hcard-head { display: flex; align-items: center; gap: var(--s2); margin-bottom: var(--s3); }
  .hcard-eyebrow { font: 500 var(--t0)/1.2 var(--font-mono); letter-spacing: 0; color: var(--ink-4); }
  .hcard-tag { padding: 1px 9px; border: 1px solid currentColor; border-radius: 999px; font: 600 var(--t0)/1.5 var(--font-sans); letter-spacing: .04em; text-transform: uppercase; color: var(--un-ink); }
  .hcard-body { font-size: var(--t2); line-height: 1.62; color: var(--ink-2); }
  .hcard-body .hcard-strong { color: var(--ink); font-weight: 600; }
  .hcard-reason { margin: var(--s3) 0 0; line-height: 1.55; }

  .hlegend { display: flex; flex-wrap: wrap; gap: var(--s2) var(--s5); margin: var(--s4) 0 0; padding: 0; list-style: none; }
  .hlegend li { display: flex; align-items: center; gap: 9px; }
  .hlegend .hlbl { font: var(--t1)/1.4 var(--font-mono); letter-spacing: 0; color: var(--ink-3); white-space: nowrap; }
  .hlegend a { color: var(--ink); text-decoration-color: var(--rule-strong); }
  .hero-action { margin: var(--s4) 0 0; }
  .hero-action a { font: 600 var(--t3)/1.4 var(--font-sans); color: var(--un-ink); text-decoration-color: var(--rule-strong); }

  /* phone: one column, and the machine comes before the card — the opening
     is still the first thing the page shows */
  @media (max-width: 860px) {
    .hero-machine { grid-template-columns: 1fr; grid-template-areas: "copy" "stage" "aside"; gap: var(--s5); }
    .hero-copy h1 { font-size: clamp(34px, 9vw, 46px); max-width: none; }
    .hero-lede { max-width: none; }
    .hero-stage { aspect-ratio: 4 / 3.6; max-height: none; min-height: 0; }
    .hlegend .hlbl { white-space: normal; }
  }

  .scrolly { margin-top: 10svh; }
  .docopen, .voids, .closer { padding: clamp(64px, 12svh, 140px) 0 0; max-width: 1080px; }
  .docopen h2, .voids h2, .closer h2 { margin: 0 0 var(--s4); font: 700 clamp(26px, 3vw, var(--t7))/1.05 var(--font-display); letter-spacing: -.03em; }
  .docbody { margin: 0 0 var(--s5); max-width: 72ch; font-size: var(--t4); line-height: 1.7; color: var(--ink-2); text-wrap: pretty; }
  .docchain .rblock h3 { margin: 0 0 var(--s3); font: var(--t0) var(--font-mono); letter-spacing: 0; color: var(--ink-4); text-transform: none; }
  .docline { margin: 6px 0 0; font-size: var(--t2); color: var(--ink-3); }
  /* the voids are the thesis, so their figures are set at reading distance */
  .voids .figrow { display: flex; flex-wrap: wrap; gap: var(--s3) var(--s7); margin: var(--s5) 0 var(--s3); padding-top: var(--s4); border-top: 1px solid var(--rule-strong); }
  .voids .figrow > span { display: flex; flex-direction: column; gap: 6px; max-width: 28rem; font-size: var(--t1); line-height: 1.35; color: var(--ink-3); }
  .voids .figrow a.fig { align-self: flex-start; font-size: clamp(34px, 3.4vw, 48px); }
  .closer { padding-bottom: 10svh; }
  .cardfigs { margin-top: var(--s3) !important; padding-top: var(--s3); border-top: 1px solid var(--rule); }
  /* no entrance animation here: this block sits 13,000px down the page, so a
     CSS animation with no trigger played and finished at parse time and no
     reader ever saw it. The gesture that belongs here is the flip. */
</style>

<script>
  import { mountWorldStage } from '../lib/scene/world-stage.mjs';
  import { chapterStart, cyclePhase, trackToProgress } from '../lib/scene/explosion-motion.mjs';

  // the chapter knots, derived from the same timing module the cards used
  const KNOTS = [...document.querySelectorAll('[data-dot]')].map((d) => chapterStart(Number(d.dataset.dot)));

  // The world stage: middle-band stepper over one mounted SVG.
  const world = document.querySelector('[data-world]');
  if (world) mountWorldStage(world);

  // ── The opening: the hero machine plays the assembly once, on load ──────
  // Driven by the same chapter data the scrub uses — the chapterStart knots
  // and the scene's own cyclePhase — so the caption and the dots can never
  // name a chapter the machine is not in. Reduced motion skips the travel and
  // lands on the assembled resting pose with the caption row static.
  const hero = document.querySelector('[data-hero]');
  const heroStage = hero && hero.querySelector('.scene-stage');
  const heroControls = heroStage && heroStage.sceneControls;
  if (hero && heroControls) {
    const caps = [...hero.querySelectorAll('[data-hcap]')];
    const hdots = [...hero.querySelectorAll('[data-hdot]')];
    const lastChapter = caps.length - 1;
    const show = (k) => {
      for (const cap of caps) cap.classList.toggle('is-on', Number(cap.dataset.hcap) === k);
      for (const dot of hdots) {
        const n = Number(dot.dataset.hdot);
        dot.classList.toggle('is-on', n === k);
        dot.classList.toggle('is-done', n < k);
      }
    };
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      heroControls.progress = 100;
      show(lastChapter);
    } else {
      // one run over the whole assembly, every chapter given the same share of
      // it (trackToProgress), starting on the first live frame so the opening
      // is not half over by the time the canvas arrives. If the rich layer
      // never comes up the server-rendered dial is already the whole picture,
      // and the row rests on the assembled chapter.
      const knots = hdots.map((d) => chapterStart(Number(d.dataset.hdot)));
      const RUN = 9000;
      let began = 0, giveUp = 0;
      const step = (now) => {
        if (!began && !heroStage.classList.contains('is-live')) {
          if (!giveUp) giveUp = now + 5000;
          if (now < giveUp) { requestAnimationFrame(step); return; }
          show(lastChapter);
          return;
        }
        if (!began) began = now;
        const t = Math.min(1, (now - began) / RUN);
        heroControls.progress = trackToProgress(t, knots) * 100;
        show(Math.min(lastChapter, cyclePhase(heroControls.progress / 100)));
        if (t < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }
  }

  // The pinned scrub (predecessor pattern): N×100svh chapter with a sticky
  // stage; a rAF-throttled scroll listener maps chapter travel to the
  // instrument's progress. Phones (<700px) pin a short stage instead and the
  // card passing under it seeks its chapter's end.
  const chapter = document.querySelector('[data-machine]');
  const stage = chapter && chapter.querySelector('.scene-stage');
  const phone = matchMedia('(max-width: 699px)');
  const full = () =>
    phone.matches ? 0 : Math.min(480, innerWidth * 0.40) + Math.max(16, Math.min(48, innerWidth * 0.04));
  let frame = 0;
  const cards = chapter ? [...chapter.querySelectorAll('.scene-card')] : [];
  const dots = chapter ? [...chapter.querySelectorAll('[data-dot]')] : [];
  const onScroll = () => {
    cancelAnimationFrame(frame);
    frame = requestAnimationFrame(() => {
      if (!chapter) return;
      if (phone.matches) {
        for (const card of cards) card.style.opacity = '';
        return;
      }
      // A card fades in as it arrives and out before its top edge reaches the
      // pinned stage heading, so the card column and the header never cross.
      // The strongest card opacity on screen also drives the camera's inset:
      // with no card beside it the machine re-centres into the whole frame
      // instead of sitting shoved against the right edge of a half-empty one.
      const headClear = 104;
      let near = 0;
      for (const card of cards) {
        const r = card.getBoundingClientRect();
        const out = Math.max(0, Math.min(1, (r.top - headClear) / 90));
        const into = Math.max(0, Math.min(1, (innerHeight - r.top) / 140));
        const o = Math.min(out, into);
        card.style.opacity = String(o);
        if (o > near) near = o;
      }
      const controls = stage && stage.sceneControls;
      if (!controls) return;
      const r = chapter.getBoundingClientRect();
      // Half-screen lead over an 8-screen scrub: progress reaches a chapter's
      // start exactly when that chapter's card crosses the viewport centre
      // (cardTop above places card k at (1 + 8·chapterStart(k))/10 of the
      // track), so a centred card and the scene always name the same chapter.
      const lead = innerHeight / 2;
      const distance = chapter.offsetHeight - 2 * innerHeight;
      if (distance > 100 && r.top <= 0 && r.bottom >= 0) {
        // Progress reaches a chapter's start exactly when that chapter's card
        // crosses the viewport centre: cardTop places card k at the centre of
        // the k-th equal slice of the track, and trackToProgress maps that
        // same slice onto the chapter's own span.
        const p = trackToProgress((-r.top - lead) / distance, KNOTS) * 100;
        controls.progress = p;
        controls.inset = full() * near;
        const chap = cyclePhase(p / 100);
        for (const dot of dots) {
          const k = Number(dot.dataset.dot);
          dot.classList.toggle('is-on', k === chap);
          dot.classList.toggle('is-done', k < chap);
        }
      }
    });
  };
  addEventListener('scroll', onScroll, { passive: true });
  addEventListener('resize', onScroll, { passive: true });
  onScroll();

  // FLIP: the case-back plate turns over to source · run time · checksum.
  // Progressive enhancement only — until this runs, both faces are ordinary
  // stacked blocks and nothing is hidden behind a transform.
  const box = document.querySelector('[data-caseback]');
  if (box) {
    box.setAttribute('data-flip-ready', '');
    const flip = document.createElement('button');
    flip.className = 'cb-btn';
    flip.type = 'button';
    flip.setAttribute('aria-expanded', 'false');
    flip.textContent = 'turn it over';
    flip.addEventListener('click', () => {
      const on = box.hasAttribute('data-flipped');
      box.toggleAttribute('data-flipped', !on);
      flip.setAttribute('aria-expanded', String(!on));
      flip.textContent = on ? 'turn it over' : 'turn it back';
    });
    const row = document.createElement('p');
    row.style.margin = '0';
    row.appendChild(flip);
    box.insertAdjacentElement('afterend', row);
  }

  // "run the assembly again": the scrub's replay — scroll back to the top of
  // the chapter and let the reader drive it a second time.
  const replay = chapter && chapter.querySelector('[data-replay]');
  if (replay && chapter) {
    replay.addEventListener('click', () => {
      const top = chapter.getBoundingClientRect().top + scrollY;
      scrollTo({ top, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    });
  }
  if (chapter) {
    const io = new IntersectionObserver(
      (entries) => {
        if (!phone.matches) return;
        for (const e of entries) {
          const controls = stage && stage.sceneControls;
          if (!e.isIntersecting || !controls) continue;
          const p = Number(e.target.dataset.phase);
          controls.progress = p === 0 ? 0 : p >= 7 ? 100 : (chapterStart(p + 1) - 0.006) * 100;
        }
      },
      { rootMargin: '-55% 0px -35% 0px' },
    );
    chapter.querySelectorAll('.scene-card').forEach((el) => io.observe(el));
  }
</script>
