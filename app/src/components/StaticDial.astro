---
// The dial as flat SVG: no three.js, no client boundary. Ported from the
// frozen predecessor (static-dial.tsx for the frame, Dial.dc.html for the
// surfaces — owner decision 2026-10-16) and remapped onto this runtime's
// honest data. Four devices come across from the comp, each carrying a count
// this runtime actually holds; nothing here is a ratio, a gauge or a guess:
//
//   · the engraved TICK BEZEL — a fine decorative ring plus one bold tick per
//     document on record, the bold tick inked by that document's state
//   · the DOCUMENT SEGMENT RING — one countable arc segment per document, at a
//     fixed angular pitch, machined solid where the bytes are held and hashed,
//     hairline where the document is on record only, hatched where the state
//     is unknown. Segments, not a sweep: the reading is "how many", not "how
//     full", so there is no gauge and no percentage anywhere on the dial.
//   · the PLEDGE GHOST RING — dashed, with its reason etched on, because no
//     pledge figure was read from any filing
//   · the EIGHT COMPONENT BORES — the report's eight parts; a part this
//     runtime has read would seat a jewel, and today every one is an empty
//     machined bore, which is the thesis rather than a blank
//
// The centre readout is two census figures inside their links (R6). Server
// -rendered everywhere the 3D movement mounts, so the instrument is itself on
// every screen — JavaScript off, WebGL lost, reduced data — not only the ones
// with a canvas.
import { SOCKETS, SCENE_COPY } from '../lib/story-content.mjs';

const { counts, href, onRecordHref = href, sockets = [], rows = [] } = Astro.props;
const C = 210;
const pol = (r, deg) => [C + r * Math.cos((deg - 90) * Math.PI / 180), C + r * Math.sin((deg - 90) * Math.PI / 180)];
// One arc segment per document on record, at a fixed pitch — countable marks,
// never a swept fraction. State decides the material, exactly as the band and
// the chips do elsewhere in the kit.
const seg = rows.length > 0
  ? rows.map((r) => ({ state: r.state, held: Boolean(r.sha256) }))
  : Array.from({ length: Math.max(1, counts.documents_on_record) }, () => ({ state: 'unknown', held: false }));
const pitch = 360 / seg.length;
const gap = Math.min(3.2, pitch * 0.22);
const RING = 176;
const arcs = seg.map((s, i) => {
  const a0 = i * pitch + gap / 2, a1 = (i + 1) * pitch - gap / 2;
  const [x0, y0] = pol(RING, a0);
  const [x1, y1] = pol(RING, a1);
  return {
    d: `M ${x0.toFixed(1)} ${y0.toFixed(1)} A ${RING} ${RING} 0 ${a1 - a0 > 180 ? 1 : 0} 1 ${x1.toFixed(1)} ${y1.toFixed(1)}`,
    cls: s.held ? 'metal' : s.state === 'unknown' ? 'unv' : 'hair',
    mid: a0 + (a1 - a0) / 2,
  };
});
// the bezel: a fine engraved ring, and one bold tick per document on record
const fine = Array.from({ length: 72 }, (_, i) => i * 5);
const bores = SOCKETS.map((s, i) => {
  const [x, y] = pol(99, (i / SOCKETS.length) * 360 + 22.5);
  return { x, y, label: s.label, state: sockets[i]?.state ?? 'unknown' };
});
---

{/* 420 wide, 452 tall: the ghost ring's reason is etched UNDER the bezel, not
    across its ticks */}
<svg viewBox="0 0 420 452" class="static-dial" aria-hidden="true">
  <defs>
    {/* côtes de Genève: the comp's 112° hairline pitch, re-tokened. The
        mainplate is a surface, not a colour fill — it is what separates a
        machined part from an extruded shape. */}
    <pattern id="dial-cotes" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(112)">
      <rect width="9" height="9" fill="var(--paper)"></rect>
      <line x1="0" y1="0" x2="9" y2="0" stroke="var(--line)" stroke-width="1.2"></line>
    </pattern>
  </defs>

  {/* bezel */}
  <circle cx={C} cy={C} r="202" class="d-case"></circle>
  <g class="d-fine">{fine.map((a) => {
    const [x0, y0] = pol(196, a);
    const [x1, y1] = pol(202, a);
    return <line x1={x0} y1={y0} x2={x1} y2={y1}></line>;
  })}</g>
  <g class="d-bold">{arcs.map((a) => {
    const [x0, y0] = pol(190, a.mid);
    const [x1, y1] = pol(203, a.mid);
    return <line x1={x0} y1={y0} x2={x1} y2={y1} class={a.cls}></line>;
  })}</g>

  {/* the document segment ring: one countable segment per document */}
  <circle cx={C} cy={C} r={RING} class="d-track"></circle>
  <g class="d-seg">{arcs.map((a) => <path d={a.d} class={a.cls}></path>)}</g>

  {/* the pledge path: no figure read, so the ring is a ghost with its reason
      etched on — dashed in ink, never a guessed arc (same as the 3D ring) */}
  <circle cx={C} cy={C} r="148" class="d-ghost"></circle>
  <text x={C} y="440" text-anchor="middle" class="d-etch">{SCENE_COPY.pledgeEtch.toUpperCase()}</text>

  {/* mainplate */}
  <circle cx={C} cy={C} r="126" class="d-plate"></circle>
  <circle cx={C} cy={C} r="126" class="d-plate-edge"></circle>

  {/* the eight component bores */}
  {bores.map((b) => (
    <circle
      cx={b.x}
      cy={b.y}
      r="13"
      class={`d-bore ${b.state === 'observed' ? 'jewel' : b.state === 'absent' ? 'plug' : 'bore'}`}
    ></circle>
  ))}

  {/* centre readout: two census figures, each inside its link (R6) */}
  <text x={C} y="182" text-anchor="middle" class="d-cap">DOCUMENTS HASHED</text>
  <a href={href}>
    <text x={C} y="230" text-anchor="middle" class="d-read">{counts.documents_with_bytes}</text>
  </a>
  <text x={C} y="256" text-anchor="middle" class="d-of">
    of <a href={onRecordHref}><tspan class="d-of-n">{counts.documents_on_record}</tspan></a> on record
  </text>
</svg>
