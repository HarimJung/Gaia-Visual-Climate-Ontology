---
// The dial as flat SVG: no three.js, no client boundary. The geometry is the
// frozen predecessor's (static-dial.tsx for the frame, the comps for the
// devices — owner decision 2026-10-16); the material is Visual Climate's own
// light system, every value of it from engine/generated/design-tokens.css
// through styles/scene.css. This is NOT a leftover: with JavaScript off, with
// WebGL lost, or under a reduced-data browser, this IS the instrument, so it
// carries every device the rich layer carries.
//
// Device by device, and the data behind each:
//
//   · ENGRAVED TICK BEZEL — a fine machined edge (decoration, no reading),
//     plus one bold tick per document on record, each tick inked by that
//     document's own state.
//   · BARREL RING — one barrel per document on record. HELD = the bytes are
//     held and hashed, so the barrel is the dial face carrying the treaty
//     edge the canon binds to it. VOID = the document is on record and this
//     runtime never held its bytes: a sunken well with the absent edge. No
//     hue separates the states; the material does. Every barrel is a link to
//     that document's receipt.
//   · FLOW PATHS + travelling spark (the PULSE motion) — one path from each
//     held barrel into the escapement. It animates EVIDENCE MOVING INTO THE
//     RECORD; it is never a number and it never counts up.
//   · CONCENTRIC HAIRLINE GUIDES and the PLEDGE GHOST RING — dashed, with its
//     reason etched under the bezel, because no pledge figure was read from
//     any filing.
//   · MAINPLATE — a raised paper face with a load-bearing rim.
//   · BTR SUBDIAL — the report's eight parts, on the reporting axis, so a
//     part this runtime has read seats a jewel in the reporting hue; a
//     pledged part takes the dial track, an absent part a plugged well, and
//     an unread part stays an empty bore hatched at the canon's unknown
//     angle, which is the thesis rather than a blank.
//   · ESCAPEMENT — the TICK, the one permanent loop, with the single jewel
//     at the point where evidence enters the record.
//   · SATELLITE on a dashed tether — a real case, not an illustration: a
//     document on record whose bytes this runtime never held. It exists, it
//     is addressed, it is not engaged. It carries that document's own title
//     and links to its receipt; it carries no figure, because the difference
//     between two counts is not a figure this runtime recorded.
//
// The centre readout is two census figures inside their links (R6). No ratio,
// no percentage, no gauge, no count-up anywhere on the dial.
import { SOCKETS, SCENE_COPY } from '../lib/story-content.mjs';

const { counts, href, onRecordHref = href, sockets = [], rows = [], iso3 = '' } = Astro.props;
const C = 500;
const pol = (r, deg) => [
  C + r * Math.cos(((deg - 90) * Math.PI) / 180),
  C + r * Math.sin(((deg - 90) * Math.PI) / 180),
];
const f1 = (n) => n.toFixed(1);

// One barrel per document on record. Order and identity come from the view's
// own rows; when a caller hands us no rows (the cover's bare counts) we fall
// back to anonymous barrels at the recorded count, every one a void, because
// without a row there is no receipt to point at and nothing to claim held.
const docs =
  rows.length > 0
    ? rows.map((r) => ({
        live: Boolean(r.sha256),
        state: r.state,
        title: r.title,
        id: r.doc_id,
      }))
    : Array.from({ length: Math.max(1, counts.documents_on_record) }, () => ({
        live: false,
        state: 'unknown',
        title: '',
        id: null,
      }));
// Geometry scaled straight off Main.dc.html (an 800 stage, plate 672, barrels
// at R=286, guides at 588/470/286, escapement 196/132/108/26) by 1000/800:
// the mainplate is 84% of the frame and the barrels sit ON it, which is the
// difference between an instrument and a diagram floating on a dark page.
const BEZEL = 445, CASE = 431, PLATE = 420;
const G1 = 367, G2 = 294;
const RING = 357;
const barrels = docs.map((d, i) => {
  const a = (i / docs.length) * 360;
  const [x, y] = pol(RING, a);
  return { ...d, a, x, y, r: d.live ? 17 : 14 };
});
// PULSE: one flow path per live barrel, curving into the escapement rim the
// way the comp's gear-train energy paths curve into the balance.
const HUB = 194;
const flows = barrels
  .filter((b) => b.live)
  .map((b, n) => {
    const rad = ((b.a - 90) * Math.PI) / 180;
    const [mx, my] = [C + Math.cos(rad + 0.34) * RING * 0.52, C + Math.sin(rad + 0.34) * RING * 0.52];
    const [ex, ey] = pol(HUB, b.a);
    return {
      d: `M ${f1(b.x)} ${f1(b.y)} Q ${f1(mx)} ${f1(my)} ${f1(ex)} ${f1(ey)}`,
      style: `animation-duration:${(2.6 + n * 0.42).toFixed(2)}s;animation-delay:${(n * 0.55).toFixed(2)}s`,
    };
  });

// the bezel: a fine engraved ring, and one bold tick per document on record
const fine = Array.from({ length: 90 }, (_, i) => i * 4);
const boldTick = barrels.map((b) => ({
  cls: b.live ? 'metal' : b.state === 'unknown' ? 'unv' : 'hair',
  a: b.a,
}));

// the BTR subdial, from Dial.dc.html: jewels at 56% of the plate's radius,
// each label outside its own bore. The engraved caption is the component's
// own key (the comp engraves NIR / CRT / CTF, not a sentence); the full
// recorded label stays on the mark as its accessible name.
const SUB = 250, LBL = 272;
const bores = SOCKETS.map((s, i) => {
  const a = (i / SOCKETS.length) * 360;
  const [x, y] = pol(SUB, a);
  const dx = Math.sin((a * Math.PI) / 180);
  const dy = -Math.cos((a * Math.PI) / 180);
  const anchor = dx > .3 ? 'start' : dx < -.3 ? 'end' : 'middle';
  const [lx, ly] = pol(LBL, a);
  const state = sockets[i]?.state ?? 'unknown';
  return {
    x, y, anchor,
    lx: lx + (anchor === 'start' ? 16 : anchor === 'end' ? -16 : 0),
    ly: ly + (anchor === 'middle' ? (dy < 0 ? -14 : 26) : 7),
    code: s.key.replace(/_/g, ' ').toUpperCase(),
    label: s.label,
    state,
  };
});

// the escapement's teeth: drawn, not patterned, so the tick stays crisp
const teeth = Array.from({ length: 72 }, (_, i) => i * 5);

// THE SATELLITE — the first document on record whose bytes were never held.
// A real row or nothing at all; never an illustration of a case we do not
// have. It sits outside the bezel on a dashed tether, unengaged.
const orphan = docs.find((d) => !d.live && d.id);
const satTitle = orphan ? (orphan.title.length > 30 ? orphan.title.slice(0, 29) + '…' : orphan.title) : '';
const [satX, satY] = pol(478, 35);
const [tethX, tethY] = pol(PLATE + 6, 35);
---

{/* 1000 wide, 1072 tall: the ghost ring's reason is etched UNDER the bezel,
    not across its ticks */}
<svg viewBox="0 0 1000 1072" class="static-dial" role="group" aria-label="Record dial">
  {/* No <defs> here. Every surface on this dial is a token: the plate is
      --paper-raised, the bezel --rule-strong, the barrels and bores the four
      state materials, and the unread bore fills from the canon's own
      generated tile, url(#t-hatch-45), inlined once per page by the layout
      (engine/generated/textures.svg). The dark instrument study's gradients,
      its cotes pattern, its raking light and its amber glow filter are gone:
      they model a near-black studio, and there is none. */}

  {/* ── engraved tick bezel: a fine machined edge, then one bold tick per
         document on record, inked by that document's own state ─────── */}
  <g class="d-fine">{fine.map((a) => {
    const [x0, y0] = pol(BEZEL - 13, a);
    const [x1, y1] = pol(BEZEL, a);
    return <line x1={f1(x0)} y1={f1(y0)} x2={f1(x1)} y2={f1(y1)}></line>;
  })}</g>
  <g class="d-bold">{boldTick.map((t) => {
    const [x0, y0] = pol(BEZEL - 24, t.a);
    const [x1, y1] = pol(BEZEL + 4, t.a);
    return <line x1={f1(x0)} y1={f1(y0)} x2={f1(x1)} y2={f1(y1)} class={t.cls}></line>;
  })}</g>
  {/* the black case ring: what the bezel's ticks are cut into */}
  <circle cx={C} cy={C} r={CASE} class="d-case"></circle>

  {/* ── the mainplate: a raised paper face with a load-bearing rim ────── */}
  <circle cx={C} cy={C} r={PLATE} class="d-plate"></circle>
  <circle cx={C} cy={C} r={PLATE} class="d-plate-edge"></circle>
  {/* the bevel: the lit top edge a turned rim catches */}
  <circle cx={C} cy={C} r={PLATE - 3} class="d-bevel"></circle>

  {/* ── concentric hairline guides (the comps' machining lines) ──────── */}
  <circle cx={C} cy={C} r={G1} class="d-hair"></circle>
  <circle cx={C} cy={C} r={G2} class="d-hair"></circle>

  {/* ── the pledge path: no figure read, so the ring is a ghost with its
         reason etched on — dashed, never a guessed arc ───────────────── */}
  <circle cx={C} cy={C} r="330" class="d-ghost"></circle>
  <text x={C} y="1052" text-anchor="middle" class="d-etch">{SCENE_COPY.pledgeEtch.toUpperCase()}</text>

  {/* ── amber flow paths, and the spark that runs them (PULSE) ───────── */}
  <g aria-hidden="true">
    {flows.map((f) => <path d={f.d} class="d-flow"></path>)}
    {flows.map((f) => <path d={f.d} class="d-spark" style={f.style}></path>)}
  </g>

  {/* ── the barrel ring: one document each, every one a receipt ──────── */}
  <g class="d-barrels">
    {barrels.map((b) =>
      b.id ? (
        <a href={`/receipt/${iso3}/${b.id}/`} data-receipt={b.id}>
          <title>{b.title} — {b.live ? 'bytes held and hashed' : 'on record, bytes not held'}</title>
          <circle
            cx={f1(b.x)}
            cy={f1(b.y)}
            r={b.r}
            class={`d-barrel ${b.live ? 'live' : 'void'}`}
          ></circle>
        </a>
      ) : (
        <circle cx={f1(b.x)} cy={f1(b.y)} r={b.r} class="d-barrel void"></circle>
      ),
    )}
  </g>

  {/* ── the BTR subdial: jewels seated, bores still empty ────────────── */}
  <circle cx={C} cy={C} r={SUB} class="d-hair"></circle>
  {bores.map((b) => (
    <circle
      cx={f1(b.x)}
      cy={f1(b.y)}
      r="15"
      class={`d-bore ${b.state === 'observed' ? 'jewel' : b.state === 'pledged' ? 'glass' : b.state === 'absent' ? 'plug' : 'bore'}`}
    ></circle>
  ))}
  {bores.map((b) => (
    <text x={f1(b.lx)} y={f1(b.ly)} text-anchor={b.anchor} class="d-cap">
      <title>{b.label}</title>{b.code}
    </text>
  ))}

  {/* ── the escapement: TICK, the only permanent loop ────────────────── */}
  <g class="d-escape" aria-hidden="true">
    {teeth.map((a) => {
      const [x0, y0] = pol(166, a);
      const [x1, y1] = pol(190, a);
      return <line x1={f1(x0)} y1={f1(y0)} x2={f1(x1)} y2={f1(y1)}></line>;
    })}
  </g>
  {/* the single jewel, in the reporting hue: where evidence enters the record */}
  <circle cx={C} cy={C - 178} r="13" class="d-jewel-core" aria-hidden="true"></circle>

  {/* ── centre readout: two census figures, each inside its link (R6) ── */}
  <text x={C} y="452" text-anchor="middle" class="d-cap">DOCUMENTS HASHED</text>
  <a href={href}>
    <text x={C} y="528" text-anchor="middle" class="d-read">{counts.documents_with_bytes}</text>
  </a>
  <text x={C} y="566" text-anchor="middle" class="d-of">
    of <a href={onRecordHref}><tspan class="d-of-n">{counts.documents_on_record}</tspan></a> on record
  </text>

  {/* ── the satellite: on record, never held, not engaged ────────────── */}
  {orphan && (
    <g class="d-satellite">
      <path d={`M ${f1(tethX)} ${f1(tethY)} L ${f1(satX)} ${f1(satY)}`} class="d-tether"></path>
      {/* the whole satellite is one link: the barrel, the state word and the
          document's own title all go to that document's receipt, so the
          title's own numerals are never a figure standing free (R6) */}
      <a href={`/receipt/${iso3}/${orphan.id}/`} data-receipt={orphan.id}>
        <title>{orphan.title} — on record, bytes not held</title>
        <circle cx={f1(satX)} cy={f1(satY)} r="18" class="d-barrel void"></circle>
        <text x={f1(satX)} y={f1(satY - 34)} text-anchor="middle" class="d-sat-lbl">NOT ENGAGED</text>
        <text x={f1(satX)} y={f1(satY - 56)} text-anchor="middle" class="d-cap">{satTitle.toUpperCase()}</text>
      </a>
    </g>
  )}
</svg>
